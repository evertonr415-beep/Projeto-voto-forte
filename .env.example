# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy fallback only if your project still uses it:
SUPABASE_SERVICE_ROLE_KEY=

# Google Drive Integration (optional)
GOOGLE_DRIVE_FOLDER_ID=

# ========================================================
# Meta WhatsApp Cloud API (official WhatsApp Business API)
# Keep all values secret in the hosting provider environment.
# ========================================================
META_WA_API_VERSION=v26.0
META_WA_PHONE_NUMBER_ID=
META_WA_WABA_ID=
META_WA_ACCESS_TOKEN=
META_WA_WEBHOOK_VERIFY_TOKEN=
META_WA_APP_SECRET=

# Equivalent long-form aliases are also supported:
# META_WHATSAPP_API_VERSION=v26.0
# META_WHATSAPP_PHONE_NUMBER_ID=
# META_WHATSAPP_WABA_ID=
# META_WHATSAPP_ACCESS_TOKEN=
# META_WHATSAPP_VERIFY_TOKEN=
# META_APP_SECRET=
